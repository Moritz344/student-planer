{
  "name": "student-planer-app",
  "version": "0.0.0",
  "description": "student planer",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "release": "standard-version",
    "start": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && npm run electron-dev\"",
    "electron-dev": "cross-env ELECTRON_DEV=true electron .",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.0",
    "fs": "^0.0.1-security",
    "rxjs": "~7.8.0",
    "standard-version": "^9.5.0",
    "tslib": "^2.3.0",
    "wait-on": "^9.1.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
